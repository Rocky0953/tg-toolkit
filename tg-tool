#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="1.3.0-dev"
CONFIG_FILE="$ROOT/config/config.json"

banner() {
  clear
  printf '\n╔══════════════════════════════════════╗\n'
  printf '║          TG-TOOLKIT v%s          ║\n' "$VERSION"
  printf '║       Telegram Management CLI        ║\n'
  printf '╚══════════════════════════════════════╝\n\n'
}

pause() { printf '\nPress Enter to continue...'; read -r; }
ok() { printf '  [✓] %s\n' "$1"; }
warn() { printf '  [!] %s\n' "$1"; }
fail() { printf '  [✗] %s\n' "$1"; }

config_exists() { [ -f "$CONFIG_FILE" ]; }

config_menu() {
  while true; do
    clear
    printf '\n╔══════════════════════════════════════╗\n'
    printf '║     TELEGRAM API CONFIGURATION      ║\n'
    printf '╚══════════════════════════════════════╝\n\n'
    printf '[1] Configure API ID\n'
    printf '[2] Configure API Hash\n'
    printf '[3] Configure Phone\n'
    printf '[4] Configuration Status\n'
    printf '[5] Security Check\n'
    printf '[6] Reset Configuration\n'
    printf '[0] Back\n\nChoose: '
    read -r c
    case "${c:-}" in
      1) set_value api_id 'API ID' ;;
      2) set_value api_hash 'API Hash' ;;
      3) set_value phone 'Phone' ;;
      4) config_status; pause ;;
      5) security_check; pause ;;
      6) reset_config ;;
      0) return ;;
      *) printf '\nInvalid option.\n'; pause ;;
    esac
  done
}

ensure_config() {
  mkdir -p "$ROOT/config"
  if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'EOF'
{
  "api_id": "",
  "api_hash": "",
  "phone": ""
}
EOF
    chmod 600 "$CONFIG_FILE"
  fi
}

set_value() {
  local key="$1" label="$2" value
  ensure_config
  printf '\n%s: ' "$label"
  if [ "$key" = "api_hash" ]; then
    read -r -s value
    printf '\n'
  else
    read -r value
  fi
  python - "$CONFIG_FILE" "$key" "$value" <<'PY'
import json, sys
path, key, value = sys.argv[1:]
with open(path, encoding='utf-8') as f:
    data = json.load(f)
data[key] = value
with open(path, 'w', encoding='utf-8') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PY
  chmod 600 "$CONFIG_FILE"
  ok "$label saved locally."
  pause
}

config_status() {
  printf '\nConfiguration Status\n'
  printf '%s\n' '────────────────────────────────────────'
  if ! config_exists; then
    warn 'config/config.json not found'
    return
  fi
  python - "$CONFIG_FILE" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as f: d=json.load(f)
except Exception as e:
    print('  [✗] Invalid JSON configuration')
    raise SystemExit(0)
for key, label in [('api_id','API ID'),('api_hash','API Hash'),('phone','Phone')]:
    value=str(d.get(key,'')).strip()
    if value:
        if key == 'api_hash': value='configured (hidden)'
        elif key == 'phone' and len(value) > 6: value=value[:3]+'*'*(len(value)-6)+value[-3:]
        print(f'  [✓] {label}: {value}')
    else:
        print(f'  [!] {label}: not configured')
PY
}

security_check() {
  printf '\nConfiguration Security Check\n'
  printf '%s\n' '────────────────────────────────────────'
  if [ -f "$CONFIG_FILE" ]; then
    perms="$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || stat -f '%Lp' "$CONFIG_FILE" 2>/dev/null || printf 'unknown')"
    if [ "$perms" = "600" ]; then ok 'config/config.json permissions: 600'; else warn "config/config.json permissions: $perms (recommended: 600)"; fi
  else warn 'config/config.json does not exist'; fi
  if git -C "$ROOT" check-ignore -q config/config.json 2>/dev/null; then ok 'config/config.json is ignored by Git'; else fail 'config/config.json is NOT ignored by Git'; fi
  if git -C "$ROOT" ls-files --error-unmatch config/config.json >/dev/null 2>&1; then fail 'config/config.json is tracked by Git'; else ok 'config/config.json is not tracked by Git'; fi
  printf '\nSecrets are never printed by this check.\n'
}

reset_config() {
  printf '\nThis removes the local Telegram configuration.\nContinue? [y/N] '
  read -r answer
  case "${answer:-}" in
    y|Y) rm -f "$CONFIG_FILE"; ok 'Local configuration removed.'; pause ;;
    *) printf 'Cancelled.\n'; pause ;;
  esac
}

doctor() {
  printf '\nTG-TOOLKIT System Doctor v1.1\n'
  printf '%s\n' '────────────────────────────────────────'
  local pass=0 warn_count=0 fail_count=0
  if [ -d /data/data/com.termux/files/usr ]; then ok 'Termux environment'; pass=$((pass+1)); else fail 'Termux environment'; fail_count=$((fail_count+1)); fi
  if [ -n "${SHELL:-}" ]; then ok "Shell: ${SHELL}"; pass=$((pass+1)); else warn 'Shell: unknown'; warn_count=$((warn_count+1)); fi
  if command -v bash >/dev/null 2>&1; then ok "Bash: $(bash --version | head -n1)"; pass=$((pass+1)); else fail 'Bash: not installed'; fail_count=$((fail_count+1)); fi
  if command -v git >/dev/null 2>&1; then ok "Git: $(git --version)"; pass=$((pass+1)); else fail 'Git: not installed'; fail_count=$((fail_count+1)); fi
  if command -v python >/dev/null 2>&1; then ok "Python: $(python --version 2>&1)"; pass=$((pass+1)); else warn 'Python: not installed'; warn_count=$((warn_count+1)); fi
  if command -v curl >/dev/null 2>&1; then ok 'Curl: installed'; pass=$((pass+1)); else warn 'Curl: not installed'; warn_count=$((warn_count+1)); fi
  if [ -d "$ROOT" ]; then ok "Project: $ROOT"; pass=$((pass+1)); else fail 'Project directory missing'; fail_count=$((fail_count+1)); fi
  for dir in config modules data logs; do if [ -d "$ROOT/$dir" ]; then ok "Directory: $dir/"; pass=$((pass+1)); else warn "Directory missing: $dir/"; warn_count=$((warn_count+1)); fi; done
  if [ -d "$ROOT/.git" ]; then
    ok 'Git checkout detected'; pass=$((pass+1))
    remote="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote" ]; then ok 'Git remote configured'; pass=$((pass+1)); else warn 'Git remote: not configured'; warn_count=$((warn_count+1)); fi
    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
    if [ -n "$branch" ]; then ok "Git branch: $branch"; pass=$((pass+1)); else warn 'Git branch: unknown'; warn_count=$((warn_count+1)); fi
  else fail 'Git checkout not detected'; fail_count=$((fail_count+1)); fi
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 8 -o /dev/null https://github.com; then ok 'Internet/GitHub connectivity'; pass=$((pass+1)); else warn 'Internet/GitHub connectivity unavailable'; warn_count=$((warn_count+1)); fi
  printf '%s\n' '────────────────────────────────────────'
  printf 'PASS: %d   WARNING: %d   ERROR: %d\n' "$pass" "$warn_count" "$fail_count"
  if [ "$fail_count" -gt 0 ]; then printf 'Status: ERROR\n'; elif [ "$warn_count" -gt 0 ]; then printf 'Status: READY WITH WARNINGS\n'; else printf 'Status: READY\n'; fi
  printf '\nSecurity: secrets, API hashes and Telegram sessions are not displayed by Doctor.\n'
}

update() {
  printf '\nChecking GitHub for updates...\n'
  if ! command -v git >/dev/null 2>&1; then printf 'Git is not installed. Run: pkg install git\n'; return; fi
  if [ ! -d "$ROOT/.git" ]; then printf 'This copy is not a Git checkout. Install it from GitHub to enable updates.\n'; return; fi
  if ! git -C "$ROOT" diff --quiet || ! git -C "$ROOT" diff --cached --quiet; then
    warn 'Local tracked changes detected. Update stopped to protect your work.'
    printf 'Review with: git status\n'
    return
  fi
  git -C "$ROOT" fetch --quiet origin main
  local local_commit remote_commit
  local_commit="$(git -C "$ROOT" rev-parse HEAD)"
  remote_commit="$(git -C "$ROOT" rev-parse origin/main)"
  if [ "$local_commit" = "$remote_commit" ]; then
    ok 'Already up to date.'
  else
    printf 'Update available. Local: %.12s  Remote: %.12s\n' "$local_commit" "$remote_commit"
    printf 'Apply fast-forward update now? [y/N] '
    read -r answer
    case "${answer:-}" in
      y|Y) git -C "$ROOT" merge --ff-only origin/main; ok 'Update completed.' ;;
      *) printf 'Update cancelled.\n' ;;
    esac
  fi
  printf 'Local commit : %.12s\n' "$(git -C "$ROOT" rev-parse HEAD)"
}

if [ "${1:-}" = "doctor" ]; then doctor; exit 0; fi
if [ "${1:-}" = "update" ]; then update; exit 0; fi
if [ "${1:-}" = "config" ]; then config_menu; exit 0; fi
if [ "${1:-}" = "version" ]; then printf '%s\n' "$VERSION"; exit 0; fi
if [ "${1:-}" = "help" ]; then printf 'Usage: tg-tool [doctor|update|config|version|help]\n'; exit 0; fi

while true; do
  banner
  printf '[1] 👤 Username Tools\n'
  printf '[2] 📱 Contact & Privacy\n'
  printf '[3] 👥 Group Manager\n'
  printf '[4] 📊 Analytics\n'
  printf '[5] 🔗 Invite Manager\n'
  printf '[6] 📁 CSV Tools\n'
  printf '[7] 🛡️ Security\n'
  printf '[8] ⚙️ Settings\n'
  printf '[9] 🩺 System Doctor\n'
  printf '[U] 🔄 Check Updates\n'
  printf '[0] 🚪 Exit\n\nChoose: '
  read -r choice
  case "${choice:-}" in
    1|2|3|4|5|6|7) printf '\nModule coming in the next release.\n'; pause ;;
    8) config_menu ;;
    9) doctor; pause ;;
    u|U) update; pause ;;
    0) exit 0 ;;
    *) printf '\nInvalid option.\n'; pause ;;
  esac
done
