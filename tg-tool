#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="1.2.0-dev"
REPO="https://github.com/Rocky0953/tg-toolkit.git"
BRANCH="main"

banner() {
  clear
  printf '\n╔══════════════════════════════════════╗\n'
  printf '║          TG-TOOLKIT v%s          ║\n' "$VERSION"
  printf '║       Telegram Management CLI        ║\n'
  printf '╚══════════════════════════════════════╝\n\n'
}

pause() { printf '\nPress Enter to continue...'; read -r; }
ok() { printf '  [✓] %s\n' "$1"; }
warn() { printf '  [!] %s\n' "$1"; }
fail() { printf '  [✗] %s\n' "$1"; }

menu() {
  banner
  printf '[1] 👤 Username Tools\n[2] 📱 Contact & Privacy\n[3] 👥 Group Manager\n[4] 📊 Analytics\n[5] 🔗 Invite Manager\n[6] 📁 CSV Tools\n[7] 🛡️ Security\n[8] ⚙️ Settings\n[9] 🩺 System Doctor\n[U] 🔄 Check Updates\n[0] 🚪 Exit\n\n'
  printf 'Choose: '
  read -r choice
  case "${choice:-}" in
    1|2|3|4|5|6|7|8) printf '\nModule coming in the next release.\n'; pause ;;
    9) doctor; pause ;;
    u|U) update; pause ;;
    0) exit 0 ;;
    *) printf '\nInvalid option.\n'; pause ;;
  esac
}

doctor() {
  printf '\nTG-TOOLKIT System Doctor v1.2\n'
  printf '%s\n' '────────────────────────────────────────'
  local pass=0 warn_count=0 fail_count=0

  if [ -d /data/data/com.termux/files/usr ]; then ok 'Termux environment'; pass=$((pass+1)); else fail 'Termux environment'; fail_count=$((fail_count+1)); fi
  if [ -n "${SHELL:-}" ]; then ok "Shell: ${SHELL}"; pass=$((pass+1)); else warn 'Shell: unknown'; warn_count=$((warn_count+1)); fi
  if command -v bash >/dev/null 2>&1; then ok "Bash: $(bash --version | head -n1)"; pass=$((pass+1)); else fail 'Bash: not installed'; fail_count=$((fail_count+1)); fi
  if command -v git >/dev/null 2>&1; then ok "Git: $(git --version)"; pass=$((pass+1)); else fail 'Git: not installed'; fail_count=$((fail_count+1)); fi
  if command -v python >/dev/null 2>&1; then ok "Python: $(python --version 2>&1)"; pass=$((pass+1)); else warn 'Python: not installed (not required yet)'; warn_count=$((warn_count+1)); fi
  if command -v curl >/dev/null 2>&1; then ok 'Curl: installed'; pass=$((pass+1)); else warn 'Curl: not installed'; warn_count=$((warn_count+1)); fi
  if [ -d "$ROOT" ]; then ok "Project: $ROOT"; pass=$((pass+1)); else fail 'Project directory missing'; fail_count=$((fail_count+1)); fi

  for dir in config modules data logs; do
    if [ -d "$ROOT/$dir" ]; then ok "Directory: $dir/"; pass=$((pass+1)); else warn "Directory missing: $dir/"; warn_count=$((warn_count+1)); fi
  done

  if [ -d "$ROOT/.git" ]; then
    ok 'Git checkout detected'; pass=$((pass+1))
    remote="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote" ]; then
      ok 'Git remote configured'; pass=$((pass+1))
      case "$remote" in *github.com/Rocky0953/tg-toolkit*) ok 'GitHub repository: Rocky0953/tg-toolkit'; pass=$((pass+1));; *) warn "Git remote is different: $remote"; warn_count=$((warn_count+1));; esac
    else warn 'Git remote: not configured'; warn_count=$((warn_count+1)); fi
    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
    if [ -n "$branch" ]; then ok "Git branch: $branch"; pass=$((pass+1)); else warn 'Git branch: unknown'; warn_count=$((warn_count+1)); fi
  else fail 'Git checkout not detected'; fail_count=$((fail_count+1)); fi

  if command -v curl >/dev/null 2>&1; then
    if curl -fsS --max-time 8 -o /dev/null https://github.com; then ok 'Internet/GitHub connectivity'; pass=$((pass+1)); else warn 'Internet/GitHub connectivity unavailable'; warn_count=$((warn_count+1)); fi
  fi

  printf '%s\n' '────────────────────────────────────────'
  printf 'PASS: %d   WARNING: %d   ERROR: %d\n' "$pass" "$warn_count" "$fail_count"
  if [ "$fail_count" -gt 0 ]; then printf 'Status: ERROR\n'; elif [ "$warn_count" -gt 0 ]; then printf 'Status: READY WITH WARNINGS\n'; else printf 'Status: READY\n'; fi
  printf '\nSecurity: secrets, API hashes and Telegram sessions are not displayed by Doctor.\n'
}

repo_status() {
  git -C "$ROOT" status --short
}

update() {
  printf '\n╔══════════════════════════════════════╗\n'
  printf '║       TG-TOOLKIT UPDATE MANAGER      ║\n'
  printf '╚══════════════════════════════════════╝\n\n'

  if ! command -v git >/dev/null 2>&1; then
    fail 'Git is not installed. Run: pkg install git'
    return 1
  fi
  if [ ! -d "$ROOT/.git" ]; then
    fail 'This copy is not a Git checkout.'
    return 1
  fi

  printf 'Current Version : %s\n' "$VERSION"
  printf 'Repository      : %s\n' "$REPO"
  printf 'Branch          : %s\n\n' "$BRANCH"

  printf 'Fetching GitHub metadata...\n'
  if ! git -C "$ROOT" fetch --quiet origin "$BRANCH"; then
    fail 'Could not contact GitHub or fetch origin.'
    return 1
  fi

  local local_sha remote_sha ahead behind dirty
  local_sha="$(git -C "$ROOT" rev-parse HEAD)"
  remote_sha="$(git -C "$ROOT" rev-parse "origin/$BRANCH")"

  if [ "$local_sha" = "$remote_sha" ]; then
    ok 'Already up to date.'
    printf 'Local commit : %.12s\n' "$local_sha"
    return 0
  fi

  ahead="$(git -C "$ROOT" rev-list --count "origin/$BRANCH..HEAD")"
  behind="$(git -C "$ROOT" rev-list --count "HEAD..origin/$BRANCH")"
  dirty="$(git -C "$ROOT" status --porcelain)"

  printf 'Local commits ahead  : %s\n' "$ahead"
  printf 'GitHub commits ahead : %s\n' "$behind"

  if [ -n "$dirty" ]; then
    warn 'Local changes detected.'
    printf '\nChanged files:\n%s\n' "$dirty"
    printf '\nUpdate blocked to protect your local work.\n'
    printf 'Review or commit your changes, then run: tg-tool update\n'
    return 2
  fi

  if [ "$ahead" -gt 0 ]; then
    warn 'Your local branch contains commits not on GitHub.'
    printf 'Update blocked to avoid overwriting local commits.\n'
    printf 'Use git status/log to review them first.\n'
    return 2
  fi

  if [ "$behind" -gt 0 ]; then
    printf '\nUpdate available! 🚀\n'
    printf 'GitHub commit: %.12s\n\n' "$remote_sha"
    printf '[1] Update now\n[2] Show changes\n[0] Cancel\n\nChoose: '
    read -r update_choice

    case "${update_choice:-}" in
      1)
        printf '\nUpdating TG-TOOLKIT...\n'
        git -C "$ROOT" pull --ff-only
        printf '\nUpdate complete. Restart TG-TOOLKIT to load the new version.\n'
        ;;
      2)
        printf '\nChanges from local HEAD to GitHub:\n\n'
        git -C "$ROOT" --no-pager log --oneline --decorate "HEAD..origin/$BRANCH"
        printf '\nPress Enter to continue...'
        read -r
        ;;
      0) printf '\nUpdate cancelled.\n' ;;
      *) printf '\nInvalid option.\n' ;;
    esac
  else
    ok 'No update required.'
  fi
}

if [ "${1:-}" = "doctor" ]; then doctor; exit 0; fi
if [ "${1:-}" = "update" ]; then update; exit $?; fi
if [ "${1:-}" = "version" ]; then printf '%s\n' "$VERSION"; exit 0; fi
if [ "${1:-}" = "help" ]; then printf 'Usage: tg-tool [doctor|update|version|help]\n'; exit 0; fi
while true; do menu; done
