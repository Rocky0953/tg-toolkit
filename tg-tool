#!/usr/bin/env bash
# ==============================================================================
# TG-TOOLKIT: Telegram Management CLI for Android Termux & Linux
# https://github.com/Rocky0953/tg-toolkit
# Version: 1.5.0-dev
# ==============================================================================

set -e

# Resolve base script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH}"

# Color codes
CYAN='\033[96m'
GREEN='\033[92m'
YELLOW='\033[93m'
RED='\033[91m'
BOLD='\033[1m'
END='\033[0m'

# Ensure required directories
mkdir -p "${SCRIPT_DIR}/config" "${SCRIPT_DIR}/data/results" "${SCRIPT_DIR}/data/input" "${SCRIPT_DIR}/logs"

# Verify Python
if command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PY_BIN="python"
else
    echo -e "${RED}[✗] Python 3 is required but not installed.${END}"
    echo -e "    Termux: pkg install python"
    exit 1
fi

print_header() {
    clear
    echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════╗${END}"
    echo -e "${CYAN}${BOLD}║              TG-TOOLKIT v1.5.0-dev           ║${END}"
    echo -e "${CYAN}${BOLD}║           Telegram Management CLI            ║${END}"
    echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════╝${END}"
    echo ""
}

show_help() {
    echo -e "${BOLD}Usage:${END} ./tg-tool [COMMAND] [ARGS]"
    echo ""
    echo -e "${BOLD}Commands:${END}"
    echo "  config              Configure Telegram API ID, API Hash, and Phone"
    echo "  connect             Authenticate & connect MTProto session"
    echo "  connection-status   Check active authorization status (alias: status)"
    echo "  disconnect          Remove local session file (alias: remove-session)"
    echo "  doctor              Run System Doctor diagnostic audit"
    echo "  username [@user]    Open Username Tools or query specific username"
    echo "  contacts            Open Contact & Privacy management"
    echo "  groups              Open Group & Channel manager"
    echo "  analytics           Run metadata analytics and stats"
    echo "  invites             Manage chat invite links"
    echo "  csv                 CSV validation, filter, and conversion tools"
    echo "  security            Audit file permissions and .gitignore protections"
    echo "  update              Check upstream GitHub repository for updates"
    echo "  version             Display current TG-TOOLKIT version"
    echo "  help                Show this help reference"
    echo ""
}

show_version() {
    echo "TG-TOOLKIT version 1.5.0-dev"
    echo "Repository: https://github.com/Rocky0953/tg-toolkit"
}

main_menu() {
    while true; do
        print_header
        echo -e "[${BOLD}1${END}] 👤 Username Tools"
        echo -e "[${BOLD}2${END}] 📱 Contact & Privacy"
        echo -e "[${BOLD}3${END}] 👥 Group Manager"
        echo -e "[${BOLD}4${END}] 📊 Analytics"
        echo -e "[${BOLD}5${END}] 🔗 Invite Manager"
        echo -e "[${BOLD}6${END}] 📁 CSV Tools"
        echo -e "[${BOLD}7${END}] 🛡️ Security Center"
        echo -e "[${BOLD}8${END}] ⚙️ Settings"
        echo -e "[${BOLD}9${END}] 🩺 System Doctor"
        echo -e "[${BOLD}U${END}] 🔄 Check Updates"
        echo -e "[${BOLD}0${END}] 🚪 Exit"
        echo ""
        read -p "Enter choice [0-9, U]: " choice

        case "$choice" in
            1)
                ${PY_BIN} -m modules.username_tools
                ;;
            2)
                ${PY_BIN} -m modules.contacts
                ;;
            3)
                ${PY_BIN} -m modules.groups
                ;;
            4)
                ${PY_BIN} -m modules.analytics
                ;;
            5)
                ${PY_BIN} -m modules.invites
                ;;
            6)
                ${PY_BIN} -m modules.csv_tools
                ;;
            7)
                ${PY_BIN} -m modules.security
                ;;
            8)
                ${PY_BIN} -m modules.settings
                ;;
            9)
                ${PY_BIN} -m modules.doctor
                ;;
            [uU])
                ${PY_BIN} -m modules.update
                ;;
            0)
                echo -e "\n${GREEN}Goodbye.${END}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection.${END}"
                sleep 1
                ;;
        esac
    done
}

# CLI Argument Routing
if [ $# -eq 0 ]; then
    main_menu
else
    cmd="$1"
    shift
    case "$cmd" in
        config)
            ${PY_BIN} -m modules.settings config
            ;;
        connect|login)
            ${PY_BIN} -m modules.telegram_connect connect
            ;;
        connection-status|status)
            ${PY_BIN} -m modules.telegram_connect status
            ;;
        disconnect|logout|remove-session)
            ${PY_BIN} -m modules.telegram_connect disconnect
            ;;
        doctor)
            ${PY_BIN} -m modules.doctor
            ;;
        username|usernames)
            if [ $# -gt 0 ]; then
                ${PY_BIN} -m modules.username_tools "$@"
            else
                ${PY_BIN} -m modules.username_tools
            fi
            ;;
        contacts|privacy)
            ${PY_BIN} -m modules.contacts
            ;;
        groups|channels)
            ${PY_BIN} -m modules.groups
            ;;
        analytics|stats)
            ${PY_BIN} -m modules.analytics
            ;;
        invites|invite)
            ${PY_BIN} -m modules.invites
            ;;
        csv|csv-tools)
            ${PY_BIN} -m modules.csv_tools
            ;;
        security|audit)
            ${PY_BIN} -m modules.security "$@"
            ;;
        update)
            ${PY_BIN} -m modules.update
            ;;
        version|-v|--version)
            show_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}[✗] Unknown command: ${cmd}${END}"
            show_help
            exit 1
            ;;
    esac
fi
